  },
  "dependencies": {
    "@datadog/browser-logs": "^6.33.0",
    "@datadog/browser-rum-slim": "^6.33.0",
    "dd-trace": "^5.80.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}

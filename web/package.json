{
  "name": "contactlogo-web",
  "private": true,
  "license": "Apache-2.0",
  "description": "ContactLogo Web — review-first logo matching for a vCard or Google CSV",
  "homepage": "https://contactlogo.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
